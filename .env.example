# Create a bot through @BotFather and keep this token private.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# The chat ID that should receive timetable changes. It may be a personal chat,
# group, or channel (for channels, the bot must be an administrator).
TELEGRAM_CHAT_ID=replace-with-your-chat-id

# Only needed if you want to test fetch_state.py / push_state.py locally
# before relying on them in CI. Not required for normal local watcher.py
# runs, which just read/write timetable.json directly.
GIST_TOKEN=replace-with-a-gist-scoped-personal-access-token
GIST_ID=replace-with-your-private-gist-id
